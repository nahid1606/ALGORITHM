#include<bits/stdc++.h>
using namespace std;
void insertMinHeap(int arr[],int &n,int val)
{
    n=n+1;
    arr[n]=val;
    int i=n;
    while(i>1)
    {
        int parent=i/2;
        if(arr[parent]>arr[i])
        {
            swap(arr[parent],arr[i]);
            i=parent;
        }
        else
        {
            break;
        }
    }
}
int main()
{
    int n;
    cin>>n;
    int arr[100];
    for(int i=1;i<=n;i++)
        cin>>arr[i];
    int val;
    cin>>val;
    insertMinHeap(arr,n,val);
    for(int i=1;i<=n;i++)
        cout<<arr[i]<<" ";
}

