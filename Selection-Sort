#include<bits/stdc++.h>
using namespace std;
void insertsort(int arr[],int n)
{
    for(int i=1;i<n;i++)
    {

        int tmp=arr[i];
        int j=i-1;
        while(j>=0 && arr[j]>tmp)
        {
            arr[j+1]=arr[j];
            j--;
        }
        arr[j+1]=tmp;
    }
}
int main()
{
    int n;
    cin>>n;
    int arr[n];
    for(int i=0;i<n;i++)
        cin>>arr[i];
    insertsort(arr,n);
    for(int i=0;i<n;i++)
       cout<<arr[i]<<" ";

}
